DJANGO_SETTINGS_MODULE=library.settings_dev
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://library:replace-local-password@db:5432/library
POSTGRES_PASSWORD=replace-local-password
TIME_ZONE=Europe/Warsaw
# For production also supply SMTP settings and a strong random secret.